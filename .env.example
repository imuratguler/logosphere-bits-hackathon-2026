# Logosphere BITS — ortam değişkeni sözleşmesi.
# YALNIZ DEĞİŞKEN ADLARI VE AÇIKLAMALAR. Bu dosyaya gerçek değer yazılmaz.
# Gerçek değerler yalnız Git'e girmeyen .env dosyasına yazılır
# (.env ve .env.* .gitignore korumalıdır).

# --- Mobilde bulunabilir (public) ---
# Merkezi Supabase proje adresi. Tüm uçlar (rest/auth/realtime/storage)
# bu tek adresten türetilir.
SUPABASE_PROJECT_ADDRESS=

# Mobil istemcinin kullandığı Supabase anonim (public) anahtarı.
SUPABASE_ANON_KEY=

# --- Yalnız sunucuda (mobil kaynakta, APK'da veya Git'te ASLA) ---
# Supabase service-role anahtarı. Satır güvenliğini atlatır; yalnız backend.
SUPABASE_SERVICE_ROLE_KEY=

# Sunucu taraflı Muse API çağrılarının anahtarı. Yalnız backend.
CLAUDE_API_KEY=
